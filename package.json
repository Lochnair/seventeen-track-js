{
  "name": "seventeen-track",
  "version": "2.0.0",
  "type": "module",
  "description": "An unofficial SDK for interacting with 17track.net to manage and track packages.",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build-gas": "esbuild src/index.ts --bundle --outfile=dist-gas/index.js --platform=browser --format=esm --banner:js=\"var window = globalThis; var self = globalThis;\" && node build-gas.js",
    "test": "tsx --test --env-file-if-exists=.env test/**/*.spec.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mderazon/seventeen-track-js.git"
  },
  "keywords": [
    "17track",
    "tracking",
    "sdk",
    "packages",
    "logistics",
    "gas",
    "google-apps-script"
  ],
  "author": "Michael DeRazon",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mderazon/seventeen-track-js/issues"
  },
  "homepage": "https://github.com/mderazon/seventeen-track-js#readme",
  "devDependencies": {
    "@types/google-apps-script": "^2.0.8",
    "@types/node": "^25.0.3",
    "@types/node-forge": "^1.3.14",
    "esbuild": "^0.27.2",
    "node-forge": "^1.3.3",
    "prettier": "^3.7.4",
    "ts2gas": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
